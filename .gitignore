.ipynb_checkpoints

# pyenv
#   For a library or package, you may want to use .python-version to define
#   the version or versions of Python to run on, but for applications,
#   you may want to put this in the global .gitignore instead.
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if you have platform-specific dependencies,
#   you may want local files like Pipfile.lock ignored
Pipfile.lock

# Poetry
#   https://python-poetry.org
poetry.lock

# pdm
#   https://fming.dev
pdm.lock
.pdm.toml

# PEP 582; used by e.g. Pdm, Hatch, and flit
__pypackages__

